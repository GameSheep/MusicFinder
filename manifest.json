{
  "manifest_version": 3,
  "name": "MusicFinder",
  "short_name": "MF",
  "version": "2.0.0",
  "description": "多平台音乐搜索与试听：网易云、QQ、酷我、酷狗、咪咕、B站（含UP主）、Audius、Apple Music、YouTube，外加电台与播客",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "img/icon128.png",
    "48": "img/icon128.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MusicFinder",
    "default_icon": "img/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-play": {
      "description": "播放 / 暂停",
      "suggested_key": { "default": "Alt+Shift+Z", "mac": "Alt+Shift+Z" }
    },
    "next-track": {
      "description": "下一首",
      "suggested_key": { "default": "Alt+Shift+Right", "mac": "Alt+Shift+Right" }
    },
    "prev-track": {
      "description": "上一首",
      "suggested_key": { "default": "Alt+Shift+Left", "mac": "Alt+Shift+Left" }
    }
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ruleset_1", "enabled": true, "path": "rules.json" }]
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "offscreen",
    "storage",
    "cookies",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
